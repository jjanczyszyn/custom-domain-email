# Copy this to .env and fill in. .env is gitignored.
# deploy.sh sources it; Terraform reads TF_VAR_* automatically.

# Where CloudWatch alarm emails go (confirm the SNS email once after first apply).
TF_VAR_alert_email=you@gmail.com

# Optional overrides (defaults shown):
# TF_VAR_region=us-east-1
# TF_VAR_project=multi-domain-email
