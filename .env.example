# Copy this to .env and fill in. .env is gitignored.
# deploy.sh sources it; Terraform reads TF_VAR_* automatically.

# Where failure emails go (dead-lettered forwards, watchdogs, relay errors).
TF_VAR_alert_email=you@gmail.com

# Set to true once the Apps Script relay is installed and working, so the canary
# emails you if it ever goes silent. Keep it here rather than passing -var on the
# command line: deploy.sh sources this file, so a later deploy would otherwise
# reset it to the default and quietly disarm the watchdog.
TF_VAR_relay_enabled=true

# Optional overrides (defaults shown):
# TF_VAR_region=us-east-1
# TF_VAR_project=multi-domain-email
